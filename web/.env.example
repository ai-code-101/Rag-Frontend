# Server-side URL of the Go API (used by the /api proxy and server components).
API_INTERNAL_URL=http://localhost:8080
# Browser-visible URL of the Go API (the widget iframe calls it directly for streaming).
PUBLIC_API_URL=http://localhost:8080
# Browser-visible URL of this web app (embedded into widget.js).
PUBLIC_WEB_URL=http://localhost:3000
